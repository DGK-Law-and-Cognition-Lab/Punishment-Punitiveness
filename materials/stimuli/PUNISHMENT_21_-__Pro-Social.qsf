ence would you give Darryl Smith for killing Frankie Williams?\u00a0 I would sentence Darryl...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>What sentence would you give Darryl Smith for killing Frankie Williams?&nbsp;<br><br>I would sentence Darryl to this number of years in prison:<\/strong><br>\n<br>\n(for a life sentence, mark 50 years)&nbsp;<br>\n&nbsp;","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":true}},"CSSliderMin":0,"CSSliderMax":50,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"What sentence would you give Darryl Smith for killing Frankie Williams?\u00a0 I would sentence Darryl...","Choices":{"1":{"Display":"Years"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"Labels":[],"QuestionText_Unsafe":"<strong>What sentence would you give Darryl Smith for killing Frankie Williams?&nbsp;<br><br>I would sentence Darryl to this number of years in prison:<\/strong><br>\n<br>\n(for a life sentence, mark 50 years)&nbsp;<br>\n&nbsp;","DataExportTag":"Q191","QuestionID":"QID191"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID192","SecondaryAttribute":"Please explain why you recommended this sentence for Darryl.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please explain why you recommended this sentence for Darryl.","DefaultChoices":false,"DataExportTag":"Sentence_OpenEnd1","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please explain why you recommended this sentence for Darryl.","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID192"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID193","SecondaryAttribute":"What do you hope this sentence will accomplish?","TertiaryAttribute":null,"Payload":{"QuestionText":"What do you hope this sentence will accomplish?","DefaultChoices":false,"DataExportTag":"Sentence_OpenEnd2","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What do you hope this sentence will accomplish?","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID193"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID194","SecondaryAttribute":"To what extent do you agree or disagree with the following statements?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>To what extent do you agree or disagree with the following statements?<\/b>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"To what extent do you agree or disagree with the following statements?","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionText_Unsafe":"<b>To what extent do you agree or disagree with the following statements?<\/b>","DataExportTag":"sdo_preamble","QuestionID":"QID194"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID195","SecondaryAttribute":"What our country needs most is discipline, with everyone following our leaders in unity.","TertiaryAttribute":null,"Payload":{"QuestionText"