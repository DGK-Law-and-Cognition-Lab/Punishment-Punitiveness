"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID137"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID138","SecondaryAttribute":"Over the past few years, Blacks have gotten less than they deserve.","TertiaryAttribute":null,"Payload":{"QuestionText":"Over the past few years, Blacks have gotten less than they deserve.","DataExportTag":"Raceresent_4","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Over the past few years, Blacks have gotten less than they deserve.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID138"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID139","SecondaryAttribute":"You will now read about a criminal event that occurred in your county.\u00a0 Please assume that all of..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>You will now read about a criminal event that occurred in your county.&nbsp;<br>\n<br>\nPlease assume that all of the facts are accurate and undisputed.&nbsp;<br>\n<br>\nPlease read the case carefully. You will later be asked for your opinions about it.<\/strong>","DefaultChoices":false,"DataExportTag":"Sentencing_Intro","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now read about a criminal event that occurred in your county.\u00a0 Please assume that all of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID139"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"Criminal punishments should be as light as possible.","TertiaryAttribute":null,"Payload":{"QuestionText":"Criminal punishments should be as light as possible.","DataExportTag":"parsimony_1","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Criminal punishments should be as light as possible.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID14"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID140","SecondaryAttribute":"You are now being asked what punishment Darryl deserves for this crime.\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>You are now being asked what punishment Darryl deserves for this crime.&nbsp;<\/strong>","DefaultChoices":false,"DataExportTag":"Sentencing_Inst1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You are now being asked what punishment Darryl deserves for this crime.\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID140"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID141","SecondaryAttribute":"Assume that Darryl's conduct amounts to second degree murder.\u00a0 The law states: \"Whoever is guilty..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Assume that Darryl's conduct amounts to second degree murder.&nbsp;<br>\n<br>\nThe law states: \"Whoever is guilty of second degree murder shall be imprisoned for any term of years, or for life in prison.\"&nbsp;<br>\n<br>\nThis means that you can decide on a sentence ranging from zero years in prison up to 50 years in prison (which is generally equivalent to life in prison).&nbsp;<br><br>Most sentences given by judges for similar charges range from 20 to 30 years.<\/strong>","DefaultChoices":false,"DataExportTag":"Sentencing_Inst2","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Assume that Darryl's conduct amounts to second degree murder.\u00a0 The law states: \"Whoever is guilty...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID141"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID142","SecondaryAttribute":"What sentence would you give Darryl Smith for killing Frankie Williams?\u00a0 I would sentence Darryl...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>What sentence would you give Darryl Smith for killing Frankie Williams?&nbsp;<br><br>I would sentence Darryl to this number of years in prison:<\/strong><br>\n<br>\n(for a life sentence, mark 50 years)&nbsp;<br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Sentence","QuestionID":"QID142","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":true}},"CSSliderMin":0,"CSSliderMax":50,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"What sentence would you give Darryl Smith for killing Frankie Williams?\u00a0 I would sentence Darryl...","Choices":{"1":{"Display":"Years"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"Labels":[]}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID143","SecondaryAttribute":"Darryl Smith had just lost his job for the second time due to closures of nearby factories.\u00a0 Days..","TertiaryAttribute":null,"Payload":{"QuestionText":"Darryl Smith had just lost his job for the second time due to closures of nearby factories.&nbsp;<br>\n<br>\nDays later, around 9:30pm, Darryl followed Frankie Williams, a teacher, as she was walking towards the parking lot of a shopping mall.&nbsp;<br>\n<br>\nDarryl snuck up on Frankie as she turned a dark corner and tried to snatch her purse. Frankie managed to hold onto her purse and swung her heavy shopping bag at him, causing a deep cut above his eyebrow. With blood pouring into his eye, Darryl became furious. He twisted her arm and began punching her.&nbsp;<br>\n<br>\nFrankie reached for her phone to call 911, but Darryl grabbed the phone and smashed it to the ground.&nbsp;<br>\n<br>\nFrankie began screaming for help. As she tried to escape Darryl's grip, he struck her in the face and she fell backwards over the railing and landed on the concrete floor two stories below. Frankie suffered major trauma to the head and died on the spot.&nbsp;<br>\n<br>\nDarryl was apprehended before he could leave the scene. He was found to be carrying a pocketknife in the inner pocket of his jacket.","DefaultChoices":false,"DataExportTag":"Vignette_1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Darryl Smith had just lost his job for the second time due to closures of nearby factories.\u00a0 Days...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID143"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID144","SecondaryAttribute":"Darryl Smith and Frankie Williams had been dating on and off for some 2 years.\u00a0 Throughout, Darry..","TertiaryAttribute":null,"Payload":{"QuestionText":"Darryl Smith and Frankie Williams had been dating on and off for some 2 years.&nbsp;<br><br>Throughout, Darryl\u2019s behavior was volatile and occasionally also violent. Frankie had twice filed reports of domestic abuse with the police and had recently obtained a restraining order against Darryl.&nbsp;<br><br>Just weeks after he was presented with the restraining order, Darryl burst into Frankie\u2019s apartment. His breath smelled of alcohol. He stated that he wanted just to talk to straighten things out.&nbsp;<br><br>Frankie demanded that he get out. He became increasingly angrier and refused to leave. When Frankie started screaming, Darryl twisted her arm and began punching her in the face.&nbsp;<br><br>Frankie managed to undo Darryl\u2019s grip and ran out of the building. Darryl chased after her. She ran along the block with blood pouring down her face , as she screamed \u201chelp! He\u2019s going to kill me!\u201d No one came to her help.&nbsp;<br><br>Darryl caught up to her as she approached a busy street. He struck her again on the head, and she fell backwards into the heavy traffic. Frankie was hit by a passing van and died.","DefaultChoices":false,"DataExportTag":"Vignette_2","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Darryl Smith and Frankie Williams had been dating on and off for some 2 years.\u00a0 Throughout, Darry...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID144"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID145","SecondaryAttribute":"Darryl Smith ran an illegal operation of stealing luxury cars and selling them for parts.\u00a0 At som..","TertiaryAttribute":null,"Payload":{"QuestionText":"Darryl Smith ran an illegal operation of stealing luxury cars and selling them for parts.&nbsp;<br><br>At some point, Darryl started suspecting that Frankie Williams, a local drug dealer, was snitching on him to the police.&nbsp;<br><br>Darryl confronted Frankie about his connections to the police. Frankie responded aggressively that he\u2019d make sure that Darryl ends up in prison.<br><br>Soon thereafter, Frankie was spotted near Darryl\u2019s garage taking photographs of the stolen cars. Darryl decided to beat Frankie up in order of deterring him from speaking to the police.<br><br>The next day, Darryl and his helper Lawrence ambushed Frankie in a dark alley. Lawrence stood guard as Darryl started to pound Frankie. Frankie managed to land a powerful punch in Darryl\u2019s face, but he was no match. Darryl beat him to ground, punching and kicking him brutally.&nbsp;<br><br>When Frankie became unresponsive, Lawrence said: \u201cThat\u2019s enough. Let\u2019s get out of here.\u201d \n\nDarryl, who was still heated from the blow he received from Frankie, kicked him in the face with all his might. The two men escaped the scene. Frankie died from the beating the following day.","DefaultChoices":false,"DataExportTag":"Vignette_3","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Darryl Smith ran an illegal operation of stealing luxury cars and selling them for parts.\u00a0 At som...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID145"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID146","SecondaryAttribute":"University of Southern California Department of Psychology\u00a0 INFORMATION SHEET FOR NON-MEDICAL RES..","TertiaryAttribute":null,"Payload":{"QuestionText":"University of Southern California Department of Psychology&nbsp;<br>\n<br>\nINFORMATION SHEET FOR NON-MEDICAL RESEARCH&nbsp;<br>\n<br>\nTitle: <strong>Evaluating Social Situations<\/strong><br>\n<br>\nYou are being asked to participate in research studies conducted by Professor Dan Simon from the Gould School of Law and the Department of Psychology at the University of Southern California.<br><br>Your participation is voluntary.<br>\n<br>\nYou must be aged 18 or older to participate.<br>\n<br>\nIn this study, we are interested in how people think about other people and abstract issues involved in social situations, in particular relating to crime and criminal punishment. You will also be given a scenario and asked to answer some questions regarding the scenario.<br>\n<br>\nCompletion of the questionnaire will constitute consent to participate in this research project.<br>\n<br>\nNo information capable of identifying you will be collected, and you will remain anonymous to the researchers.<br>\n<br>\nYou will be compensated at the rate stated in the invitation that you received to participate in the study.<br>\n<br>\nThe file with your responses to the items in the study will be used only for data analysis. Only the investigators will have access to registration and data files. The data files that you submit will be stored for 5 years. When the results of the research are published or discussed in conferences, no information will be included that could reveal your identity.<br>\n<br>\nYou can choose whether to be in this study or not. If you volunteer to be in this study, you may withdraw at any time without consequences of any kind. You may also refuse to answer any questions you don't want to answer and still remain in the study.<br>\n<br>\nThe investigators may withdraw you from the analysis of this research if circumstances arise which warrant doing so.<br>\n<br>\nYou may participate in this study only once (we check for that). If you choose to participate in the study, you will be expected to engage seriously in the task (we check for that too).<br>\n<br>\nIf you have any questions or concerns about the research, please feel free to contact: Professor Dan Simon at dsimon@law.usc.edu. You may withdraw your consent at any time and discontinue participation without penalty. You are not waiving any legal claims, rights, or remedies because of your participation in this research study. If you have any questions regarding your rights as a research subject, contact The Office for the Protection of Research Subjects, 3720 South Flower Street, Third Floor, Los Angeles, CA 90089-0706, (213) 821-1154, oprs@usc.edu.","DefaultChoices":false,"DataExportTag":"Consent","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"University of Southern California Department of Psychology\u00a0 INFORMATION SHEET FOR NON-MEDICAL RES...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID146"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID147","SecondaryAttribute":"How safe do you feel walking at night in the vicinity of your home?","TertiaryAttribute":null,"Payload":{"QuestionText":"How safe do you feel walking at night in the vicinity of your home?","DefaultChoices":false,"DataExportTag":"fear_1","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How safe do you feel walking at night in the vicinity of your home?","Choices":{"1":{"Display":"Not safe at all"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"&nbsp;"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Very safe"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID147"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID148","SecondaryAttribute":"How much do you fear that you will be a victim of a serious crime?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much do you fear that you will be a victim of a serious crime?","DefaultChoices":false,"DataExportTag":"fear_2","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How much do you fear that you will be a victim of a serious crime?","Choices":{"1":{"Display":"Not at all"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"&nbsp;"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Very much so"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID148"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID149","SecondaryAttribute":"How much do you fear that someone will break into your home in the next 12 months?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much do you fear that someone will break into your home in the next 12 months?","DefaultChoices":false,"DataExportTag":"fear_3","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How much do you fear that someone will break into your home in the next 12 months?","Choices":{"1":{"Display":"Not at all"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"&nbsp;"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Very much so"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID149"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"The state should not punish more than is absolutely necessary. ","TertiaryAttribute":null,"Payload":{"QuestionText":"The state should not punish more than is absolutely necessary.&nbsp;","DataExportTag":"parsimony_2","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"The state should not punish more than is absolutely necessary. ","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID15"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID150","SecondaryAttribute":"What our country needs most is discipline, with everyone following our leaders in unity.","TertiaryAttribute":null,"Payload":{"QuestionText":"What our country needs most is discipline, with everyone following our leaders in unity.","DataExportTag":"rwa_1","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"What our country needs most is discipline, with everyone following our leaders in unity.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID150"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID153","SecondaryAttribute":"The state should punish criminals because --","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>The state should punish criminals because --<\/b>","DefaultChoices":false,"DataExportTag":"Retribution","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"The state should punish criminals because --","Choices":{"1":{"Display":"Justice requires that crimes be punished"},"2":{"Display":"Justice is restored when criminals are punished"},"3":{"Display":"Criminals deserve to be punished"},"4":{"Display":"Punishment is the way criminals repay their debt to society"},"5":{"Display":"Punishment negates the unfair advantage that criminals gain over law-abiding citizens"},"6":{"Display":"Punishment recognizes offenders as moral agents and thereby affirms their dignity"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":8,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID153"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID154","SecondaryAttribute":"To what extent do you agree or disagree with the following statements?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>To what extent do you agree or disagree with the following statements?<\/b>","DefaultChoices":false,"DataExportTag":"","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"To what extent do you agree or disagree with the following statements?","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID154"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID155","SecondaryAttribute":"The state should punish criminals also because --","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>The state should punish criminals also because --<\/b>","DefaultChoices":false,"DataExportTag":"solidarity","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"The state should punish criminals also because --","Choices":{"1":{"Display":"Removing criminals from society helps society cleanse itself"},"2":{"Display":"Punishing criminals brings the law-abiding society closer together"},"3":{"Display":"Punishing criminals expresses society's norms"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":8,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID155"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"People convicted three times for a felony should be imprisoned for life.","TertiaryAttribute":null,"Payload":{"QuestionText":"People convicted three times for a felony should be imprisoned for life.","DataExportTag":"threestrikes_1","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"People convicted three times for a felony should be imprisoned for life.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID16"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"People convicted three times for shoplifting should serve at least 25 years in prison.","TertiaryAttribute":null,"Payload":{"QuestionText":"People convicted three times for shoplifting should serve at least 25 years in prison.","DataExportTag":"threestrikes_2","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"People convicted three times for shoplifting should serve at least 25 years in prison.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID17"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID179","SecondaryAttribute":"You will now be asked for your opinions about issues relating to crime.\u00a0 Most questions will ask...","TertiaryAttribute":null,"Payload":{"QuestionText":"You will now be asked for your opinions about issues relating to crime.&nbsp;<br>\n<br>\nMost questions will ask you to state your level of agreement with a stated sentence, using a scale that ranges from \u201cStrongly disagree\u201d to \u201cStrongly agree.\u201d&nbsp;<br>\n<br>\n<strong>There are no right or wrong answers; we are interested just in how you personally feel about the issues.&nbsp;<\/strong><br>\n<br>\nRemember that your responses will remain entirely anonymous.&nbsp;","DefaultChoices":false,"DataExportTag":"Intro_1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now be asked for your opinions about issues relating to crime.\u00a0 Most questions will ask...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID179"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"How much do you agree or disagree with the following statements?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>How much do you agree or disagree with the following statements?<\/b>","DefaultChoices":false,"DataExportTag":"q_intro","QuestionID":"QID18","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much do you agree or disagree with the following statements?","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID180","SecondaryAttribute":"Responding to this study requires that you read the questions carefully. Failing to do so will un...","TertiaryAttribute":null,"Payload":{"QuestionText":"Responding to this study requires that you read the questions carefully.<br \/>\n<br \/>\nFailing to do so will undermine the value of your participation and may subject you to being removed from the study.<br \/>\n<br \/>\n<strong>We thank you in advance for your participation and attention.<\/strong>","DefaultChoices":false,"DataExportTag":"Intro_2","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Responding to this study requires that you read the questions carefully. Failing to do so will un...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID180"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID181","SecondaryAttribute":"An ideal society requires some groups to be on top and others to be on the bottom.","TertiaryAttribute":null,"Payload":{"QuestionText":"An ideal society requires some groups to be on top and others to be on the bottom.","DataExportTag":"sdo_1","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"An ideal society requires some groups to be on top and others to be on the bottom.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID181"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID182","SecondaryAttribute":"You are now being asked what punishment Darryl deserves for this crime.\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>You are now being asked what punishment Darryl deserves for this crime.&nbsp;<\/strong>","DefaultChoices":false,"DataExportTag":"Q108","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You are now being asked what punishment Darryl deserves for this crime.\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID182"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID183","SecondaryAttribute":"Assume that Darryl's conduct amounts to second degree murder.\u00a0 The law states: \"Whoever is guilty..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Assume that Darryl's conduct amounts to second degree murder.&nbsp;<br>\n<br>\nThe law states: \"Whoever is guilty of second degree murder shall be imprisoned for any term of years, or for life in prison.\"&nbsp;<br>\n<br>\nThis means that you can decide on a sentence ranging from zero years in prison up to 50 years in prison (which is generally equivalent to life in prison). Most sentences given by judges for second degree murder range from 20 to 30 years, although judges sometimes give as little as 10 years and sometimes as much as 50 years.<\/strong>","DefaultChoices":false,"DataExportTag":"Q109","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Assume that Darryl's conduct amounts to second degree murder.\u00a0 The law states: \"Whoever is guilty...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID183"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID184","SecondaryAttribute":"What sentence would you give Darryl Smith for killing Frankie Williams?\u00a0 I would sentence Darryl...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>What sentence would you give Darryl Smith for killing Frankie Williams?&nbsp;<br><br>I would sentence Darryl to this number of years in prison:<\/strong><br>\n<br>\n(for a life sentence, mark 50 years)&nbsp;<br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Q110","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":true}},"CSSliderMin":0,"CSSliderMax":50,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"What sentence would you give Darryl Smith for killing Frankie Williams?\u00a0 I would sentence Darryl...","Choices":{"1":{"Display":"Years"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"Labels":[],"QuestionID":"QID184"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID185","SecondaryAttribute":"You will now read about a criminal event that occurred in your county.\u00a0 Please assume that all of..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>You will now read about a criminal event that occurred in your county.&nbsp;<br>\n<br>\nPlease assume that all of the facts are accurate and undisputed.&nbsp;<br>\n<br>\nPlease read the case carefully. You will later be asked for your opinions about it.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now read about a criminal event that occurred in your county.\u00a0 Please assume that all of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>You will now read about a criminal event that occurred in your county.&nbsp;<br>\n<br>\nPlease assume that all of the facts are accurate and undisputed.&nbsp;<br>\n<br>\nPlease read the case carefully. You will later be asked for your opinions about it.<\/strong>","DataExportTag":"Q185","QuestionID":"QID185"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID186","SecondaryAttribute":"Darryl Smith had just lost his job for the second time due to closures of nearby factories.\u00a0 Days..","TertiaryAttribute":null,"Payload":{"QuestionText":"Darryl Smith had just lost his job for the second time due to closures of nearby factories.&nbsp;<br>\n<br>\nDays later, around 9:30pm, Darryl followed Frankie Williams, a teacher, as she was walking towards the parking lot of a shopping mall.&nbsp;<br>\n<br>\nDarryl snuck up on Frankie as she turned a dark corner and tried to snatch her purse. Frankie managed to hold onto her purse and swung her heavy shopping bag at him, causing a deep cut above his eyebrow. With blood pouring into his eye, Darryl became furious. He twisted her arm and began punching her.&nbsp;<br>\n<br>\nFrankie reached for her phone to call 911, but Darryl grabbed the phone and smashed it to the ground.&nbsp;<br>\n<br>\nFrankie began screaming for help. As she tried to escape Darryl's grip, he struck her in the face and she fell backwards over the railing and landed on the concrete floor two stories below. Frankie suffered major trauma to the head and died on the spot.&nbsp;<br>\n<br>\nDarryl was apprehended before he could leave the scene. He was found to be carrying a pocketknife in the inner pocket of his jacket.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Darryl Smith had just lost his job for the second time due to closures of nearby factories.\u00a0 Days...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"Darryl Smith had just lost his job for the second time due to closures of nearby factories.&nbsp;<br>\n<br>\nDays later, around 9:30pm, Darryl followed Frankie Williams, a teacher, as she was walking towards the parking lot of a shopping mall.&nbsp;<br>\n<br>\nDarryl snuck up on Frankie as she turned a dark corner and tried to snatch her purse. Frankie managed to hold onto her purse and swung her heavy shopping bag at him, causing a deep cut above his eyebrow. With blood pouring into his eye, Darryl became furious. He twisted her arm and began punching her.&nbsp;<br>\n<br>\nFrankie reached for her phone to call 911, but Darryl grabbed the phone and smashed it to the ground.&nbsp;<br>\n<br>\nFrankie began screaming for help. As she tried to escape Darryl's grip, he struck her in the face and she fell backwards over the railing and landed on the concrete floor two stories below. Frankie suffered major trauma to the head and died on the spot.&nbsp;<br>\n<br>\nDarryl was apprehended before he could leave the scene. He was found to be carrying a pocketknife in the inner pocket of his jacket.","DataExportTag":"Q186","QuestionID":"QID186"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID187","SecondaryAttribute":"Darryl Smith and Frankie Williams had been dating on and off for some 2 years.\u00a0 Throughout, Darry..","TertiaryAttribute":null,"Payload":{"QuestionText":"Darryl Smith and Frankie Williams had been dating on and off for some 2 years.&nbsp;<br><br>Throughout, Darryl\u2019s behavior was volatile and occasionally also violent. Frankie had twice filed reports of domestic abuse with the police and had recently obtained a restraining order against Darryl.&nbsp;<br><br>Just weeks after he was presented with the restraining order, Darryl burst into Frankie\u2019s apartment. His breath smelled of alcohol. He stated that he wanted just to talk to straighten things out.&nbsp;<br><br>Frankie demanded that he get out. He became increasingly angrier and refused to leave. When Frankie started screaming, Darryl twisted her arm and began punching her in the face.&nbsp;<br><br>Frankie managed to undo Darryl\u2019s grip and ran out of the building. Darryl chased after her. She ran along the block with blood pouring down her face , as she screamed \u201chelp! He\u2019s going to kill me!\u201d No one came to her help.&nbsp;<br><br>Darryl caught up to her as she approached a busy street. He struck her again on the head, and she fell backwards into the heavy traffic. Frankie was hit by a passing van and died.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Darryl Smith and Frankie Williams had been dating on and off for some 2 years.\u00a0 Throughout, Darry...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"Darryl Smith and Frankie Williams had been dating on and off for some 2 years.&nbsp;<br><br>Throughout, Darryl\u2019s behavior was volatile and occasionally also violent. Frankie had twice filed reports of domestic abuse with the police and had recently obtained a restraining order against Darryl.&nbsp;<br><br>Just weeks after he was presented with the restraining order, Darryl burst into Frankie\u2019s apartment. His breath smelled of alcohol. He stated that he wanted just to talk to straighten things out.&nbsp;<br><br>Frankie demanded that he get out. He became increasingly angrier and refused to leave. When Frankie started screaming, Darryl twisted her arm and began punching her in the face.&nbsp;<br><br>Frankie managed to undo Darryl\u2019s grip and ran out of the building. Darryl chased after her. She ran along the block with blood pouring down her face , as she screamed \u201chelp! He\u2019s going to kill me!\u201d No one came to her help.&nbsp;<br><br>Darryl caught up to her as she approached a busy street. He struck her again on the head, and she fell backwards into the heavy traffic. Frankie was hit by a passing van and died.","DataExportTag":"Q187","QuestionID":"QID187"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID188","SecondaryAttribute":"Darryl Smith ran an illegal operation of stealing luxury cars and selling them for parts.\u00a0 At som..","TertiaryAttribute":null,"Payload":{"QuestionText":"Darryl Smith ran an illegal operation of stealing luxury cars and selling them for parts.&nbsp;<br><br>At some point, Darryl started suspecting that Frankie Williams, a local drug dealer, was snitching on him to the police.&nbsp;<br><br>Darryl confronted Frankie about his connections to the police. Frankie responded aggressively that he\u2019d make sure that Darryl ends up in prison.<br><br>Soon thereafter, Frankie was spotted near Darryl\u2019s garage taking photographs of the stolen cars. Darryl decided to beat Frankie up in order of deterring him from speaking to the police.<br><br>The next day, Darryl and his helper Lawrence ambushed Frankie in a dark alley. Lawrence stood guard as Darryl started to pound Frankie. Frankie managed to land a powerful punch in Darryl\u2019s face, but he was no match. Darryl beat him to ground, punching and kicking him brutally.&nbsp;<br><br>When Frankie became unresponsive, Lawrence said: \u201cThat\u2019s enough. Let\u2019s get out of here.\u201d \n\nDarryl, who was still heated from the blow he received from Frankie, kicked him in the face with all his might. The two men escaped the scene. Frankie died from the beating the following day.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Darryl Smith ran an illegal operation of stealing luxury cars and selling them for parts.\u00a0 At som...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"Darryl Smith ran an illegal operation of stealing luxury cars and selling them for parts.&nbsp;<br><br>At some point, Darryl started suspecting that Frankie Williams, a local drug dealer, was snitching on him to the police.&nbsp;<br><br>Darryl confronted Frankie about his connections to the police. Frankie responded aggressively that he\u2019d make sure that Darryl ends up in prison.<br><br>Soon thereafter, Frankie was spotted near Darryl\u2019s garage taking photographs of the stolen cars. Darryl decided to beat Frankie up in order of deterring him from speaking to the police.<br><br>The next day, Darryl and his helper Lawrence ambushed Frankie in a dark alley. Lawrence stood guard as Darryl started to pound Frankie. Frankie managed to land a powerful punch in Darryl\u2019s face, but he was no match. Darryl beat him to ground, punching and kicking him brutally.&nbsp;<br><br>When Frankie became unresponsive, Lawrence said: \u201cThat\u2019s enough. Let\u2019s get out of here.\u201d \n\nDarryl, who was still heated from the blow he received from Frankie, kicked him in the face with all his might. The two men escaped the scene. Frankie died from the beating the following day.","DataExportTag":"Q188","QuestionID":"QID188"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID189","SecondaryAttribute":"You are now being asked what punishment Darryl deserves for this crime.\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>You are now being asked what punishment Darryl deserves for this crime.&nbsp;<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You are now being asked what punishment Darryl deserves for this crime.\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>You are now being asked what punishment Darryl deserves for this crime.&nbsp;<\/strong>","DataExportTag":"Q189","QuestionID":"QID189"}},{"SurveyID":"SV_a5HLBhIlPBip7iC","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"Rather than showing criminals so much tolerance, we should be punishing them more severely.","TertiaryAttribute":null,"Payload":{"QuestionText":"Rather than showing criminals so much tolerance, we should be punishing them more severely.","DataExportTag":"revenge_4","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Rather than showing criminals so much tolerance, we should be punishing them more severely.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"Neutral"},"5":{"Display":"&nbsp;"},"6":{"Display":"&nbsp;"},"7":{"Display":"Strongly agree"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"Q